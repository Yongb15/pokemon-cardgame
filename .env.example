# Copy to .env and fill in. Never commit .env.
# Neon PostgreSQL, dev branch, pooled connection strings (sslmode=require)
# The app's least-privilege role (app_rw): what the API uses
DATABASE_URL=
# The owner role: only for local migrations (npm run db:migrate) and seeding
DATABASE_URL_OWNER=
# Protects /api/cron/prices (32+ random characters; different per Vercel environment)
CRON_SECRET=
