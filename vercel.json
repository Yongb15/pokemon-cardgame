{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cards.ts": {
      "includeFiles": "{data/index.json,data/sets.json,data/missing-images.json,data/cards/**}",
      "maxDuration": 10
    },
    "api/cron/prices.ts": {
      "includeFiles": "{data/index.json,data/tcgdex-map.json,server/prices/fixtures/**}",
      "maxDuration": 300
    },
    "api/prices.ts": {
      "includeFiles": "{data/index.json,data/tcgdex-map.json,server/prices/fixtures/**}",
      "maxDuration": 15
    },
    "api/price-top.ts": {
      "includeFiles": "{data/index.json,data/tcgdex-map.json,apps/api/src/packs/pool.json}",
      "maxDuration": 15
    },
    "api/price-packs.ts": {
      "includeFiles": "{data/index.json,data/tcgdex-map.json,apps/api/src/packs/pool.json}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/prices/top",
      "destination": "/api/price-top"
    },
    {
      "source": "/api/prices/packs",
      "destination": "/api/price-packs"
    },
    {
      "source": "/api/cards/:id/prices",
      "destination": "/api/prices?id=:id"
    },
    {
      "source": "/api/cards/:path*",
      "destination": "/api/cards?path=:path*"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; img-src 'self' data: https://yongb15.github.io https://images.pokemontcg.io https://images.scrydex.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/prices",
      "schedule": "0 18 * * *"
    }
  ]
}
